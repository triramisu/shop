# EDGE PROFILE: baseline
# KHÔNG áp dụng giảm thiểu ở edge (không rate limit, không connection limit).
# Dùng làm mốc đối chứng trong lab: đo hệ thống chịu tải ra sao khi chỉ còn
# các lớp phòng vệ ở tầng ứng dụng (rate limit trong JVM, CAPTCHA...).
# KHÔNG dùng profile này ngoài môi trường lab cô lập.

upstream app_upstream {
    server ${APP_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    server_name _;
    client_max_body_size ${EDGE_MAX_BODY};

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        include /etc/nginx/snippets/common-proxy.conf;
        proxy_pass http://app_upstream;
    }

    location /actuator/health {
        include /etc/nginx/snippets/common-proxy.conf;
        proxy_pass http://app_upstream;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
