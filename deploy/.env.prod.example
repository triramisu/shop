SHOP_IMAGE=docker.io/t1r4m15u/shop:sha-0000000000000000000000000000000000000000

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

MYSQL_DATABASE=shop
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replaceWithRandomBase64RootPassword1234567890
MYSQL_RUNTIME_USERNAME=shop_runtime
MYSQL_RUNTIME_PASSWORD=replaceWithRandomBase64RuntimePassword123456
MYSQL_MIGRATION_USERNAME=shop_migration
MYSQL_MIGRATION_PASSWORD=replaceWithRandomBase64MigrationPassword12

MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replaceWithRandomMinioAccessKey1234
MINIO_ROOT_PASSWORD=replaceWithRandomBase64MinioSecret1234567890
MINIO_BUCKET=shop-product-images
MINIO_AUTO_CREATE_BUCKET=true
MINIO_ENDPOINT=http://minio:9000

JWT_SIGNER_KEY=replaceWithAtLeast64RandomBytesForTheProductionJwtSigningKeyMaterial1234567890
JWT_ISSUER=shop
JWT_AUDIENCE=shop-api
CORS_ALLOWED_ORIGINS=https://frontend.example.com

PAYMENT_PROVIDER_TYPE=none
OPENAPI_ENABLED=false
SWAGGER_UI_ENABLED=false
