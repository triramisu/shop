SHOP_IMAGE=docker.io/t1r4m15u/shop:sha-0000000000000000000000000000000000000000

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

MYSQL_DATABASE=shop
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=replaceWithRandomBase64RootPassword1234567890
MYSQL_RUNTIME_USERNAME=shop_runtime
MYSQL_RUNTIME_PASSWORD=replaceWithRandomBase64RuntimePassword123456
MYSQL_MIGRATION_USERNAME=shop_migration
MYSQL_MIGRATION_PASSWORD=replaceWithRandomBase64MigrationPassword12

MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replaceWithRandomMinioAccessKey1234
MINIO_ROOT_PASSWORD=replaceWithRandomBase64MinioSecret1234567890
MINIO_BUCKET=shop-product-images
MINIO_AUTO_CREATE_BUCKET=true
MINIO_ENDPOINT=http://minio:9000

JWT_SIGNER_KEY=replaceWithAtLeast64RandomBytesForTheProductionJwtSigningKeyMaterial1234567890
JWT_ISSUER=shop
JWT_AUDIENCE=shop-api
CORS_ALLOWED_ORIGINS=https://frontend.example.com
# Must match the location used when creating inventory; DEMO seed: DEMO-LAB.
CHECKOUT_INVENTORY_LOCATION_CODE=MAIN

PAYMENT_PROVIDER_TYPE=none
OPENAPI_ENABLED=false
SWAGGER_UI_ENABLED=false
## Chưa bật hoàn tiền production khi chưa có adapter/webhook/reconciliation.
PAYMENT_REFUND_ENABLED=false

# VNPay SANDBOX, không phải cấu hình thanh toán thật.
# Chỉ đổi provider=vnpay khi có merchant secret riêng và HTTPS backend.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PREVIOUS_HASH_SECRETS=
VNPAY_PUBLIC_BASE_URL=
VNPAY_ALLOWED_HOSTS=
VNPAY_CHECKOUT_TTL=10m
VNPAY_BANK_CODE=
# Query adapter only; no reconciliation worker yet. Keep disabled for deployment.
VNPAY_QUERY_ENABLED=false
VNPAY_QUERY_SERVER_IP=
VNPAY_QUERY_CONNECT_TIMEOUT=2s
VNPAY_QUERY_READ_TIMEOUT=3s
VNPAY_QUERY_CALL_TIMEOUT=5s
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_BATCH_SIZE=10
PAYMENT_RECONCILIATION_MAX_ATTEMPTS=12
PAYMENT_RECONCILIATION_MINIMUM_AGE=10m
PAYMENT_RECONCILIATION_MAXIMUM_AGE=24h
PAYMENT_RECONCILIATION_LEASE_DURATION=30s
PAYMENT_RECONCILIATION_PROVIDER_INTERVAL=5s
PAYMENT_RECONCILIATION_RETRY_BASE=1m
PAYMENT_RECONCILIATION_RETRY_MAX=30m
PAYMENT_RECONCILIATION_FIXED_DELAY=10s
PAYMENT_RECONCILIATION_INITIAL_DELAY=30s
