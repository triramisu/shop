# Cấu hình môi trường LAB. Sao chép thành .env.lab rồi điền giá trị ngẫu nhiên.
# KHÔNG commit .env.lab. KHÔNG dùng cho production.

# --- Bề mặt target ---
# Địa chỉ edge nginx lắng nghe trên host lab. 0.0.0.0 để các máy khác trong
# mạng LAB CÔ LẬP truy cập. Luôn đặt sau firewall; không bao giờ expose Internet.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

# --- Profile giảm thiểu ở edge ---
# hardened = có rate/connection limit + timeout. baseline = không có (đối chứng).
EDGE_PROFILE=hardened
EDGE_API_RATE=50r/s
EDGE_API_BURST=100
EDGE_AUTH_RATE=5r/s
EDGE_AUTH_BURST=10
EDGE_CONN_PER_IP=20
EDGE_MAX_BODY=30m

# --- Giới hạn tài nguyên container (biên của lab) ---
APP_MEM_LIMIT=768m
APP_CPUS=1.0
WEB_MEM_LIMIT=256m
WEB_CPUS=1.0
MYSQL_MEM_LIMIT=1g
MYSQL_CPUS=1.0
MINIO_MEM_LIMIT=512m
MINIO_CPUS=0.5

# --- Secrets (đặt giá trị ngẫu nhiên) ---
MYSQL_DATABASE=shop
MYSQL_USER=shop
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MINIO_ROOT_USER=shop-lab-access
MINIO_ROOT_PASSWORD=replace-with-random-minio-secret
MINIO_BUCKET=shop-product-images
# Tối thiểu 64 byte ngẫu nhiên.
JWT_SIGNER_KEY=replace-with-at-least-64-random-bytes-for-the-lab-jwt-signing-key-00

# --- Phòng vệ tầng ứng dụng (giữ BẬT; chỉ hạ khi chủ ý đo đối chứng) ---
AUTH_RATE_LIMIT_ENABLED=true
AUTH_CAPTCHA_ENABLED=true

PAYMENT_PROVIDER_TYPE=fake
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
