# Reference ONLY. Create a secret outside this repository with real values.
# SecretString must contain Docker env-file TEXT, not JSON or shell exports.
# Replace RDS_ENDPOINT, CLOUDFRONT_DOMAIN and every REPLACE_* value.
SPRING_DATASOURCE_URL=jdbc:mysql://RDS_ENDPOINT:3306/shop?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/run/rds-truststore.p12&trustCertificateKeyStorePassword=changeit&trustCertificateKeyStoreType=PKCS12
SPRING_DATASOURCE_USERNAME=shop_runtime
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_UNIQUE_RUNTIME_PASSWORD
SPRING_FLYWAY_URL=jdbc:mysql://RDS_ENDPOINT:3306/shop?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/run/rds-truststore.p12&trustCertificateKeyStorePassword=changeit&trustCertificateKeyStoreType=PKCS12
SPRING_FLYWAY_USERNAME=shop_migration
SPRING_FLYWAY_PASSWORD=REPLACE_WITH_DIFFERENT_MIGRATION_PASSWORD
JWT_SIGNER_KEY=REPLACE_WITH_RANDOM_SHARED_SIGNING_KEY_AT_LEAST_64_CHARACTERS
CORS_ALLOWED_ORIGINS=https://CLOUDFRONT_DOMAIN
# Must match stock location_code; the deployed DEMO seed uses DEMO-LAB.
# Use MAIN for a warehouse whose stock rows are actually at MAIN.
CHECKOUT_INVENTORY_LOCATION_CODE=MAIN
# Do not add MINIO_*, AWS_*, S3_BUCKET, S3_REGION or OBJECT_STORAGE_TYPE here.
# CloudFormation injects the S3 bucket/region/type; EC2 role supplies credentials.
# Optional bounded settings, validated by the application:
S3_PRESIGNED_URL_TTL=15m
S3_CONNECT_TIMEOUT=2s
S3_READ_TIMEOUT=5s
S3_CALL_TIMEOUT=8s

# The launch template selects the provider via PaymentMode; keep this staged off.
# Configure merchant credentials only in the private secret, never this example.
# Sandbox activation/HTTPS/IPN gates: docs/vnpay-sandbox-preflight.md.
PAYMENT_PROVIDER_TYPE=none
PAYMENT_REFUND_ENABLED=false
