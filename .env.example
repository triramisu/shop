MYSQL_DATABASE=shop
MYSQL_USER=shop
MYSQL_PASSWORD=shop-local-password
MYSQL_ROOT_PASSWORD=root-local-password
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=shop
SPRING_DATASOURCE_PASSWORD=shop-local-password
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_ISSUER=shop
JWT_AUDIENCE=shop-api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SIGNER_KEY=replace-with-a-production-secret-containing-at-least-64-bytes
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT_BUCKET_IDLE_TIME=10m
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_FAILURE_THRESHOLD=3
AUTH_CAPTCHA_FAILURE_WINDOW=15m
AUTH_CAPTCHA_CHALLENGE_TTL=2m
CHECKOUT_DISCOUNT_RATE=0
CHECKOUT_TAX_RATE=0

# Giữ "fake" khi phát triển offline. Chỉ đổi thành "stripe" sau khi điền đủ
# sáu biến STRIPE_* bên dưới.
PAYMENT_PROVIDER_TYPE=fake
# Stripe sandbox dùng khóa máy chủ bắt đầu bằng sk_test_; không dùng publishable key.
STRIPE_SECRET_KEY=
# Secret riêng 32-512 ký tự hiển thị, không khoảng trắng; không dùng lại Stripe key/JWT key.
STRIPE_RETURN_STATE_SECRET=
# Lấy whsec_... từ Stripe Workbench hoặc output của `stripe listen`; có thể đặt nhiều khóa, phân tách bằng dấu phẩy, khi xoay khóa.
STRIPE_WEBHOOK_SECRETS=
# HTTP loopback chỉ được chấp nhận với sk_test_; môi trường khác phải dùng HTTPS.
STRIPE_SUCCESS_URL=http://localhost:8080/api/payments/checkout/return
STRIPE_CANCEL_URL=http://localhost:8080/api/payments/checkout/cancel
# Danh sách hostname phân tách bằng dấu phẩy; không gồm scheme, port hoặc path.
STRIPE_ALLOWED_RETURN_HOSTS=localhost,127.0.0.1
## Refund B.1: chỉ fake ở dev/test; mặc định tắt, không hoàn tiền thật.
PAYMENT_REFUND_ENABLED=false

# VNPay SANDBOX opt-in: PAYMENT_PROVIDER_TYPE=vnpay. Không cần Stripe key.
# Không điền merchant secret vào file example hoặc image; dùng env riêng ngoài Git.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Tối đa 2 secret cũ, phân tách dấu phẩy, chỉ giữ trong cửa sổ chuyển khóa đã thống nhất.
VNPAY_PREVIOUS_HASH_SECRETS=
# HTTPS backend origin (không path hoặc dấu / cuối), không phải URL frontend.
VNPAY_PUBLIC_BASE_URL=
VNPAY_ALLOWED_HOSTS=
VNPAY_CHECKOUT_TTL=10m
# Trống: chọn phương thức trên hosted checkout; VNPAYQR: chỉ QR sandbox.
VNPAY_BANK_CODE=

# M5.6A: chỉ tạo adapter truy vấn, chưa có scheduler/cập nhật state. Giữ tắt khi deploy.
VNPAY_QUERY_ENABLED=false
# IPv4 egress/NAT của backend, không phải IP browser hoặc URL. Chỉ bắt buộc khi bật query.
VNPAY_QUERY_SERVER_IP=
VNPAY_QUERY_CONNECT_TIMEOUT=2s
VNPAY_QUERY_READ_TIMEOUT=3s
VNPAY_QUERY_CALL_TIMEOUT=5s
