MYSQL_DATABASE=shop
MYSQL_USER=shop
MYSQL_PASSWORD=shop-local-password
MYSQL_ROOT_PASSWORD=root-local-password
JWT_ISSUER=shop
JWT_AUDIENCE=shop-api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
JWT_SIGNER_KEY=replace-with-a-production-secret-containing-at-least-64-bytes
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT_BUCKET_IDLE_TIME=10m
AUTH_CAPTCHA_ENABLED=true
AUTH_CAPTCHA_FAILURE_THRESHOLD=3
AUTH_CAPTCHA_FAILURE_WINDOW=15m
AUTH_CAPTCHA_CHALLENGE_TTL=2m
